# Electrony Bills environment configuration
# Copy this file to .env in the project root or bills-api/.env before running the Bills API.
# Do not commit real secrets to source control.

ELECTRONY_BILLS_PORT=4174
BILLS_APP_URL=http://localhost:4173/bills/app/
# In Railway production, use the exact standalone app root: https://bills.electrony.xyz/ (not /bills/app/).
BILLS_PAYMENT_REDIRECT_URL=http://localhost:4173/bills/app/?payment=success
BILLS_WEBHOOK_BASE_URL=http://localhost:4174
# Frontend build-time API base URL. Set this in Vercel to the HTTPS Railway API URL and redeploy.
BILLS_API_BASE_URL=http://localhost:4174
# Optional comma-separated additional browser origins; BILLS_APP_URL is also allowed.
BILLS_ALLOWED_ORIGINS=
# Use a private random value of at least 32 characters. Never expose or commit the real value.
BILLS_JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
BILLS_DATABASE_URL=~/.electrony-bills/transactions.json
# Server-only URL from the Bills App Supabase Session Pooler Connect screen; never expose to browser code.
# Copy its exact host, port, database, and electrony_bills_runtime username; never guess connection details.
BILLS_RUNTIME_DATABASE_URL=replace_with_supabase_postgresql_connection_url
# Configure exactly one: Bills App Supabase root CA PEM contents OR an absolute mounted PEM file path.
BILLS_POSTGRES_CA=
BILLS_POSTGRES_CA_FILE=

# Server-only Railway Bills API configuration; do not set these in Vercel browser/build variables.
# Explicit environment and matching Monnify API base URL are both required.
# Accepted pairs: sandbox + https://sandbox.monnify.com, or production + https://api.monnify.com.
MONNIFY_ENVIRONMENT=sandbox
MONNIFY_API_KEY=replace_with_monnify_sandbox_api_key
MONNIFY_SECRET_KEY=replace_with_monnify_sandbox_secret_key
MONNIFY_CONTRACT_CODE=replace_with_monnify_contract_code
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Payment operations remain hard-blocked until payment, database, and vending readiness are verified.
PAYMENTS_BLOCKED=true

# Electrony Identity server-side validation (public publishable key only; never use a service-role key)
ELECTRONY_IDENTITY_SUPABASE_URL=https://your-project-ref.supabase.co
ELECTRONY_IDENTITY_SUPABASE_PUBLISHABLE_KEY=replace_with_the_identity_project_publishable_key
# OAuth 2.1 public client ID for Electrony Bills (token_endpoint_auth_method=none).
# Register this only in the Supabase OAuth Server dashboard; the API does not use a client secret.
ELECTRONY_IDENTITY_OAUTH_CLIENT_ID=replace_with_the_registered_bills_oauth_client_id
# Exact deployed Bills OAuth callback. Production must be the Railway HTTPS API origin plus this path.
# Production value: https://electronyxyz-parent-page-production.up.railway.app/api/auth/oauth/callback
BILLS_OAUTH_CALLBACK_URL=http://localhost:4174/api/auth/oauth/callback

# Marplerad virtual-card integration (official credentials only; live calls remain disabled)
MARPLERAD_BASE_URL=
MARPLERAD_API_KEY=
MARPLERAD_API_SECRET=
MARPLERAD_WEBHOOK_SECRET=
MARPLERAD_ENVIRONMENT=sandbox

# Teloadly gift-card integration (official credentials only; live calls remain disabled)
TELOADLY_BASE_URL=
TELOADLY_API_KEY=
TELOADLY_API_SECRET=
TELOADLY_WEBHOOK_SECRET=
TELOADLY_ENVIRONMENT=sandbox

# Public Electrony Account application configuration (browser-safe values only).
# Set in the accounts.electrony.xyz Vercel project. Do not use a Supabase service-role or secret key here.
ELECTRONY_IDENTITY_SUPABASE_URL=https://your-project-ref.supabase.co
ELECTRONY_IDENTITY_SUPABASE_PUBLISHABLE_KEY=replace_with_the_identity_project_publishable_key

# Contact enquiry delivery (server-side only; set in Vercel and/or Railway deployment variables).
# CONTACT_EMAIL is the recipient mailbox. Use an address you control; no recipient is assumed here.
CONTACT_EMAIL=replace-with-recipient@example.com
# Set to a sender address/domain verified in Resend. Never put the API key in frontend configuration.
CONTACT_FROM_EMAIL=Electrony Enquiries <verified-sender@example.com>
RESEND_API_KEY=re_replace_with_resend_api_key
