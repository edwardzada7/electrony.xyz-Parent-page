# Electrony Bills environment configuration
# Copy this file to .env in the project root or bills-api/.env before running the Bills API.
# Do not commit real secrets to source control.

ELECTRONY_BILLS_PORT=4174
BILLS_APP_URL=http://localhost:4173/bills/app/
BILLS_PAYMENT_REDIRECT_URL=http://localhost:4173/bills/app/?payment=success
BILLS_WEBHOOK_BASE_URL=http://localhost:4174
# Frontend build-time API base URL. Set this in Vercel to the HTTPS Railway API URL and redeploy.
BILLS_API_BASE_URL=http://localhost:4174
# Optional comma-separated additional browser origins; BILLS_APP_URL is also allowed.
BILLS_ALLOWED_ORIGINS=
# Use a private random value of at least 32 characters. Never expose or commit the real value.
BILLS_JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
BILLS_DATABASE_URL=~/.electrony-bills/transactions.json

# Local sandbox example only. Production must explicitly configure HTTPS production endpoints.
MONNIFY_API_KEY=replace_with_monnify_sandbox_api_key
MONNIFY_SECRET_KEY=replace_with_monnify_sandbox_secret_key
MONNIFY_CONTRACT_CODE=replace_with_monnify_contract_code
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_WEBHOOK_SECRET=replace_with_monnify_webhook_secret

# Bills vending provider
BILLS_VENDING_PROVIDER=
BILLS_PROVIDER_BASE_URL=
BILLS_PROVIDER_API_KEY=
BILLS_PROVIDER_SECRET_KEY=
BILLS_PROVIDER_WEBHOOK_SECRET=
BILLS_PROVIDER_TIMEOUT_MS=20000

# Optional provider-specific configuration
BILLS_PROVIDER_NAME=
BILLS_PROVIDER_COUNTRY=NG
